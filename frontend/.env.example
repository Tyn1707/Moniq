# ---------------------------------------------------------------------------
# FinanceTrack frontend environment (all values are build-time, and PUBLIC —
# never put a secret in a VITE_ variable, it ends up in the browser bundle).
# ---------------------------------------------------------------------------

# Where the Vite dev server proxies /api to. The proxy keeps the browser on one
# origin so the httpOnly, SameSite=Strict auth cookie is sent with requests.
VITE_API_PROXY_TARGET=http://localhost:4000
