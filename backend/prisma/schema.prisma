// Moniq — Prisma schema
//
// PROVIDER PORTABILITY
// --------------------
// This schema is intentionally written to work on both SQLite (local dev, zero
// install) and PostgreSQL (the stack recommended in the project brief).
// To move to PostgreSQL:
//   1. change `provider = "sqlite"` below to `provider = "postgresql"`
//   2. point DATABASE_URL at your Postgres instance
//   3. run `npm run prisma:migrate`
// No model changes are required, because we avoid SQLite-incompatible features
// (native enums, `@db.*` native type attributes).
//
// Enum-like columns (`type`, `paymentMethod`) are stored as String and are
// constrained at the application boundary by Zod validators in
// src/validators/*, using the constants in src/utils/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String

  // Onboarding / preferences
  currency             String  @default("IDR")
  initialBalance       Decimal @default(0)
  monthlyIncomeTarget  Decimal @default(0)
  onboardingCompleted  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  holdings     Holding[]

  @@map("users")
}

model Holding {
  id     String @id @default(cuid())
  userId String

  // Yahoo Finance symbol, uppercased. Indonesian equities carry the ".JK"
  // (Jakarta) suffix, e.g. "BBCA.JK". Stored as given so the price service can
  // query the vendor directly without re-deriving it.
  symbol String
  // Human-friendly label captured at add time (e.g. "Bank Central Asia").
  name   String

  // Number of shares (lots × 100 is left to the user). Decimal so fractional
  // holdings and precise cost basis never accumulate float error, exactly like
  // transaction amounts.
  shares      Decimal
  // Average buy price per share, in the holding's own currency.
  avgBuyPrice Decimal
  // Currency the instrument trades in (IDR for .JK). Kept per-holding so a
  // future multi-market portfolio does not need a schema change.
  currency    String @default("IDR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per instrument per user; adding more of the same symbol updates the
  // existing position rather than creating a duplicate.
  @@unique([userId, symbol])
  @@index([userId])
  @@map("holdings")
}

model PriceCache {
  // The vendor symbol is the natural key — a quote is global, not per-user, so
  // every user's holding of "BBCA.JK" shares one cached price.
  symbol String @id

  price             Decimal
  currency          String   @default("IDR")
  // Previous close, used to derive the day's change without a second request.
  previousClose     Decimal?
  // Short display name returned by the vendor, cached for the UI.
  shortName         String?
  // When this quote was fetched. The price service treats a row older than its
  // TTL as stale and refreshes it, so we never hammer the vendor.
  fetchedAt         DateTime @default(now())

  @@map("price_cache")
}

model Category {
  id     String @id @default(cuid())
  userId String

  name String
  // "INCOME" | "EXPENSE"
  type String
  // true for the default category set created at registration
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name, type])
  @@index([userId, type])
  @@map("categories")
}

model Transaction {
  id         String @id @default(cuid())
  userId     String
  categoryId String

  // "INCOME" | "EXPENSE" — denormalised from Category so that income/expense
  // aggregation never needs a join, and so historical rows keep their meaning.
  type            String
  amount          Decimal
  description     String
  transactionDate DateTime
  paymentMethod   String   @default("CASH")
  notes           String?

  // Lowercased "description + notes", maintained by the transaction service.
  // Prisma's case-insensitive `mode: 'insensitive'` filter is not available on
  // SQLite, and plain `contains` is case-sensitive on PostgreSQL — matching
  // against a pre-lowercased column gives identical search behaviour on both.
  searchText String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, transactionDate])
  @@index([userId, type])
  @@index([userId, categoryId])
  @@map("transactions")
}

model Budget {
  id         String @id @default(cuid())
  userId     String
  categoryId String

  amount      Decimal
  periodStart DateTime
  periodEnd   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, periodStart])
  @@index([userId, periodStart])
  @@map("budgets")
}
