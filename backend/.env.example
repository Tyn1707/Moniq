# ---------------------------------------------------------------------------
# FinanceTrack backend environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Database -------------------------------------------------------------------
# Local dev (SQLite, no install required):
DATABASE_URL="file:./dev.db"
#
# PostgreSQL (see the portability note at the top of prisma/schema.prisma —
# switch the datasource provider to "postgresql" before using this):
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/financetrack?schema=public"

# Auth -----------------------------------------------------------------------
# Generate a strong random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. The server refuses to boot without it.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cookie ---------------------------------------------------------------------
# Set COOKIE_SECURE=true whenever the API is served over HTTPS.
COOKIE_SECURE=false

# CORS -----------------------------------------------------------------------
# Comma-separated list of allowed browser origins (the Vite dev server).
CORS_ORIGIN=http://localhost:5173
